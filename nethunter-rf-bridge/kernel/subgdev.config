# subGdev / RF Bridge kernel config fragment for Kali NetHunter kernels.
# Lets the Kali chroot see the board as /dev/ttyACM0 (ESP32-S3 native USB)
# or /dev/ttyUSB0 (CH340 / CP210x / FTDI bridge boards).
# The subGdev APK does NOT need any of this (it uses the Android USB Host API).
CONFIG_USB_OTG=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
